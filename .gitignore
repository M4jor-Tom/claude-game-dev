.credentials.json
mcp-needs-auth-cache.json
history.jsonl
.last-cleanup
sessions/
session-env/
projects/
cache/
paste-cache/
file-history/
shell-snapshots/
tasks/
todos/
telemetry/
statsig/
jobs/
daemon/
backups/
plugins/
ide/
*.bak
